# Create a bot with BotFather, then copy this file to .env and fill in the values.
TELEGRAM_BOT_TOKEN=

# Comma-separated numeric Telegram user IDs. Example: 123456789,987654321
TELEGRAM_ALLOWED_USER_IDS=

# ── Optional cross-platform overrides (all have safe defaults) ───────────────
# Root directory for notes/, logs/, config/, data/, jobs_jd/ etc.
# Default: the repository root itself (works on Windows and Linux alike).
# JARVIS_BASE_DIR=/var/lib/jarvis

# Ollama endpoint and model selection (defaults match the local setup).
# OLLAMA_URL=http://localhost:11434
# JARVIS_LIGHT_MODEL=gemma2:2b
# JARVIS_HEAVY_MODEL=qwen2.5:7b

# Gmail OAuth redirect URI (override when running behind a reverse proxy).
# GMAIL_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/gmail/oauth/callback
